{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geographic_name",
  "type": "object",
  "properties": {
    "id": { "type": "string", "description": "UUIDv7 of the feature" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "t50_fid": {
      "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 4294967295 }, { "type": "null" }],
      "description": "Reference topo50 feature ID.\n\nWill be null if the feature is new and has not been published in a Topo50 edition."
    },
    "type": { "$ref": "#/$defs/geographic_name_type" },
    "name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "size": { "type": "number" },
    "theme": { "type": "string", "const": "annotation" },
    "metadata": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "geometry": { "description": "GeoParquet 1.1 covering geometry struct.", "not": { "type": "null" } },
    "bbox": { "$ref": "#/$defs/BBox", "description": "GeoParquet 1.1 covering bbox struct." }
  },
  "required": ["id", "created_at", "updated_at", "t50_fid", "type", "name", "size", "theme", "metadata", "geometry"],
  "additionalProperties": false,
  "$defs": {
    "geographic_name_type": {
      "type": "string",
      "enum": [
        "airport",
        "bay_inlet",
        "beach",
        "bridge",
        "building",
        "bank",
        "mountain_basin",
        "cave",
        "cemetery",
        "camping_ground",
        "cliff",
        "crater",
        "dam",
        "estuary",
        "waterfall",
        "farm",
        "flat",
        "ford",
        "forest",
        "geothermal_area",
        "glacier",
        "golf_links",
        "gorge_valley",
        "hill",
        "historic",
        "hospital",
        "homestead",
        "hut",
        "island",
        "isthmus",
        "lake",
        "locality",
        "lighthouse",
        "miscellaneous_cultural_feature",
        "metropolis",
        "mine",
        "miscellaneous_natural_feature",
        "miscellaneous_place",
        "marine_rock_formation",
        "navigational_beacon",
        "native_land_reserve",
        "pa",
        "park",
        "pass",
        "peninsula",
        "point",
        "populated_place",
        "pipeline",
        "racecourse",
        "ridge",
        "road_related_feature",
        "railway_related_feature",
        "range",
        "rock",
        "railway_station",
        "suburb",
        "school",
        "sea",
        "ski",
        "slip",
        "spring",
        "strait",
        "stream",
        "swamp",
        "town",
        "track",
        "tree",
        "trig",
        "tunnel",
        "tramway",
        "university",
        "urban_satellite",
        "well",
        "wharf",
        "wilderness_area",
        "wreck",
        "water_way"
      ]
    },
    "BBox": {
      "type": "object",
      "properties": {
        "xmin": { "type": "number" },
        "ymin": { "type": "number" },
        "xmax": { "type": "number" },
        "ymax": { "type": "number" }
      },
      "required": ["xmin", "ymin", "xmax", "ymax"],
      "description": "GeoParquet 1.1 covering bbox struct.",
      "additionalProperties": false
    }
  }
}
