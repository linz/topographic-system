{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sea_polygon",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "UUID for the feature."
    },
    "updated_at": {
      "type": "object",
      "properties": {}
    },
    "created_at": {
      "type": "object",
      "properties": {},
      "description": "Default at write time: today."
    },
    "quadkey": {
      "type": "string",
      "description": "Web Mercator quadkey of the tile this sea polygon was sliced to."
    },
    "type": {
      "type": "string",
      "const": "moana"
    },
    "geometry": {
      "description": "WKB polygon geometry in NZGD2000 (EPSG:4167).",
      "not": {
        "type": "null"
      }
    }
  },
  "required": ["id", "updated_at", "created_at", "quadkey", "type", "geometry"],
  "description": "Derived sea (moana) polygons for the water layer.\n\nThe land polygons (coastline and island) are inverted and sliced by Web\nMercator quadkey tiles so no single large polygon exists.",
  "additionalProperties": false
}
