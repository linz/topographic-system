{
  "name": "@linzjs/topographic-system-schema",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "tspMain": "src/main.tsp",
  "main": "src/types/index.ts",
  "types": "src/types/index.ts",
  "exports": {
    ".": {
      "typespec": "./src/main.tsp",
      "types": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    }
  },
  "engines": {
    "node": "^24.5.0"
  },
  "scripts": {
    "check": "tsp format --check \"src/**/*.tsp\"",
    "format": "tsp format \"src/**/*.tsp\"",
    "bundle": "tsp compile . && (cd ../../schema && oxfmt .) && oxfmt src"
  },
  "devDependencies": {
    "@linzjs/typespec-emitter": "^0.1.0",
    "@types/node": "^24.10.0"
  },
  "dependencies": {
    "@typespec/compiler": "^1.15.0",
    "@typespec/json-schema": "^1.15.0",
    "@typespec/versioning": "^0.85.0"
  }
}
