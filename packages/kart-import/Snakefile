from kart_import.config import (
    get_themes,
    get_releases,
    get_kart_repos,
    DATASET_MAP,
    DATASET_TO_THEME_MAP,
    THEME_SUFFIX,
    TRANSFORM_SUFFIX,
    LOOKUP_TO_THEME_MAP,
    SOURCE_REPO_MAP,
    get_source_entry,
    get_source_repo_name,
)
from kart_import.export_paths import export_filename

import atexit
import os
import sys

from kart_import.log import get_tracer
from opentelemetry.trace import StatusCode

# Load configuration details from the Python package
THEMES = get_themes()
RELEASES = get_releases()
REPOS = get_kart_repos()
THEME_MAP = {t.name: t for t in THEMES}
# Local source clones; datasets sharing a multi-dataset repo (e.g. topographic-source-data) share one clone.
SOURCE_REPOS = list(SOURCE_REPO_MAP)


def cloned(name):
    """Sentinel for the source clone a dataset/lookup reads from."""
    return f"data/source/{get_source_repo_name(get_source_entry(name))}/.cloned"

# Start root span for this Snakemake run so all distributed jobs and logs link together
tracer = get_tracer("kart_import")
target_args = [arg for arg in sys.argv[1:] if not arg.startswith("-")]
workflow_target = " ".join(target_args) if target_args else "all"

root_span = tracer.start_span(
    f"snakemake: {workflow_target}",
    attributes={
        "workflow.target": workflow_target,
        "workflow.args": " ".join(sys.argv[1:]),
    },
)
span_ctx = root_span.get_span_context()
run_trace_id = format(span_ctx.trace_id, "032x")
run_span_id = format(span_ctx.span_id, "016x")
os.environ["TRACEPARENT"] = f"00-{run_trace_id}-{run_span_id}-01"

# Per-invocation run id (the trace id, whether generated above or inherited). Used to
# scope log files so each run's logs live in their own directory and match the `TraceId`
# embedded in every JSON log record. `ls -t logs/bundle/` finds the latest run.
RUN_ID = run_trace_id


def _end_root_span(status_code=None, description=""):
    # The tracer provider flushes/shuts down on its own atexit handler (see log.py);
    # this only needs to end the span so that handler has something to export.
    if root_span.is_recording():
        if status_code is not None:
            root_span.set_status(status_code, description)
        root_span.end()


atexit.register(_end_root_span)


# TARGETS
ALL_IMPORTED = [f"data/output/{repo}/.imported" for repo in REPOS]

rule all:
    input:
        ALL_IMPORTED


# 1. CLONE (one clone per source repo, shared by every dataset/lookup sourced from it)
rule clone:
    output:
        cloned = "data/source/{repo}/.cloned"
    threads: 1
    shell:
        "OTEL_SERVICE_NAME=clone uv run python -m kart_import.assets.clone {wildcards.repo}"


# 2. LIFECYCLE
rule lifecycle:
    input:
        cloned = lambda wildcards: cloned(wildcards.dataset),
        config = lambda wildcards: f"config/themes/{DATASET_TO_THEME_MAP[wildcards.dataset].name}.yml"
    output:
        lifecycle = "data/working/lifecycle/{dataset}_release" + f"{RELEASES[0].id}-{RELEASES[-1].id}.json"
    threads: 1
    shell:
        "OTEL_SERVICE_NAME=lifecycle uv run python -m kart_import.assets.fid_lifecycle {wildcards.dataset}"


# 3a. EXPORT RELEASES (Produces all release files for a dataset at once)
rule export:
    input:
        cloned = lambda wildcards: cloned(wildcards.dataset)
    output:
        files = [f"data/working/export/release_{r.id}/" + export_filename("{dataset}") for r in RELEASES]
    threads: 4
    shell:
        "OTEL_SERVICE_NAME=export uv run python -m kart_import.assets.export {wildcards.dataset}"


# 3b. EXPORT LOOKUP (one export of full lookup source per distinct commit across releases; not per release)
rule export_lookup:
    input:
        cloned = lambda wildcards: cloned(wildcards.lookup)
    output:
        exported = directory("data/working/export/lookup/{lookup}")
    shell:
        "OTEL_SERVICE_NAME=export_lookup uv run python -m kart_import.assets.export --lookup {wildcards.lookup}"


# 3c. PREPARE LOOKUPS (slim derived lookup table per commit that will be joined into datasets)
rule prepare_lookup:
    input:
        # clone must be present: prepare reads each commit's declared schema from it.
        cloned = lambda wildcards: cloned(wildcards.lookup),
        exported = "data/working/export/lookup/{lookup}",
        config = lambda wildcards: f"config/themes/{LOOKUP_TO_THEME_MAP[wildcards.lookup].name}.yml"
    output:
        prepared = directory("data/working/lookup/{lookup}")
    shell:
        "OTEL_SERVICE_NAME=prepare_lookup uv run python -m kart_import.assets.prepare {wildcards.lookup}"


# 4. TRANSFORM (every release of one dataset, run together in one process with a thread pool 
rule transform:
    input:
        lifecycle = "data/working/lifecycle/{dataset}_release" + f"{RELEASES[0].id}-{RELEASES[-1].id}.json",
        # clone must be present: transform reads the source's declared schema from it.
        cloned = lambda wildcards: cloned(wildcards.dataset),
        exported = [f"data/working/export/release_{r.id}/" + export_filename("{dataset}") for r in RELEASES],
        config = lambda wildcards: f"config/themes/{DATASET_TO_THEME_MAP[wildcards.dataset].name}.yml",
        fixups = lambda wildcards: (
            ["src/kart_import/fixups.py"] if DATASET_MAP[wildcards.dataset].fixups else []
        ),
        lookups = lambda wildcards: [
            f"data/working/lookup/{join.lookup}"
            for join in DATASET_MAP[wildcards.dataset].joins
        ],
        # clone must be present (not just the prepared parquet).
        lookup_clones = lambda wildcards: [
            cloned(join.lookup)
            for join in DATASET_MAP[wildcards.dataset].joins
        ],
        example_deps = lambda wildcards: [
            f"data/working/transform/release_{r.id}/{ds.name}{TRANSFORM_SUFFIX}"
            for theme_name in DATASET_MAP[wildcards.dataset].depends_on_themes
            for ds in THEME_MAP[theme_name].datasets
            for r in RELEASES
        ]
    output:
        transformed = [f"data/working/transform/release_{r.id}/{{dataset}}" + TRANSFORM_SUFFIX for r in RELEASES]
    threads: 8
    shell:
        "OTEL_SERVICE_NAME=transform uv run python -m kart_import.assets.transform {wildcards.dataset}"


# 5. THEME RELEASE (every release of one theme, run together in one process with a thread pool)
rule theme_release:
    input:
        config = "config/themes/{theme}.yml",
        transformed = lambda wildcards: [
            f"data/working/transform/release_{r.id}/{ds.name}{TRANSFORM_SUFFIX}"
            for r in RELEASES
            for ds in THEME_MAP[wildcards.theme].datasets
        ]
    output:
        merged = [f"data/working/theme/release_{r.id}/{{theme}}" + THEME_SUFFIX for r in RELEASES]
    threads: 4
    shell:
        "OTEL_SERVICE_NAME=theme_release uv run python -m kart_import.assets.theme {wildcards.theme}"

rule kart_theme:
    input:
        themes = lambda wildcards: [
            f"data/working/theme/release_{r.id}/{wildcards.theme}{THEME_SUFFIX}"
            for r in RELEASES
        ]
    output:
        imported = "data/output/{theme}.bundle"
    shell:
        "OTEL_SERVICE_NAME=kart_theme uv run python -m kart_import.assets.kart_import_theme {wildcards.theme}"

rule kart_repo:
    input:
        themes = lambda wildcards: [
            f"data/output/{t.name}.bundle"
            for t in THEMES if t.target_repo == wildcards.repo
        ]
    output:
        imported = "data/output/{repo}/.imported"
    shell:
        "OTEL_SERVICE_NAME=kart_repo uv run python -m kart_import.assets.kart_import_repo {wildcards.repo}"


# 6. PUSH (push a built target repo to its GitHub remote - a release-named branch by default)
rule push:
    input:
        imported = "data/output/{repo}/.imported"
    output:
        pushed = "data/output/{repo}/.pushed"
    shell:
        "OTEL_SERVICE_NAME=push uv run python -m kart_import.assets.kart_push_repo {wildcards.repo}"


# 7. UTILITY PULL RULE (refresh an already-cloned source if it's behind the published bundle)
rule pull:
    input:
        cloned = "data/source/{repo}/.cloned"
    output:
        pulled = "data/source/{repo}/.pulled"
    shell:
        "OTEL_SERVICE_NAME=pull uv run python -m kart_import.assets.pull {wildcards.repo}"


# 8. UTILITY BUNDLE RULE
rule bundle:
    output:
        sentinel = "data/source/{repo}/.bundle_created"
    log:
        # Per-repo, per-run log so parallel jobs don't interleave, runs don't clobber
        # each other, and failures are easy to isolate:
        #   grep -l '"SeverityText": "ERROR"' logs/bundle/$RUN_ID/*.log
        # The {RUN_ID} directory matches the `TraceId` in every JSON log record.
        f"logs/bundle/{RUN_ID}/{{repo}}.log"
    threads: 4
    shell:
        "OTEL_SERVICE_NAME=bundle uv run python -m kart_import.assets.bundle {wildcards.repo} > {log} 2>&1"



for name in DATASET_MAP:
    workflow.rule(name=f"clone_{name}")(
        workflow.input(cloned(name))(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

workflow.rule(name="clone_all")(
    workflow.input([f"data/source/{repo}/.cloned" for repo in SOURCE_REPOS])(
        workflow.run(lambda *args, **kwargs: None)
    )
)

workflow.rule(name="bundle_all")(
    workflow.input([f"data/source/{repo}/.bundle_created" for repo in SOURCE_REPOS])(
        workflow.run(lambda *args, **kwargs: None)
    )
)

workflow.rule(name="pull_all")(
    workflow.input([f"data/source/{repo}/.pulled" for repo in SOURCE_REPOS])(
        workflow.run(lambda *args, **kwargs: None)
    )
)

workflow.rule(name="lifecycle_all")(
    workflow.input(
        [f"data/working/lifecycle/{name}_release{RELEASES[0].id}-{RELEASES[-1].id}.json" for name in DATASET_MAP]
    )(workflow.run(lambda *args, **kwargs: None))
)

for t in THEMES:
    workflow.rule(name=f"theme_{t.name}")(
        workflow.input([f"data/working/theme/release_{r.id}/{t.name}{THEME_SUFFIX}" for r in RELEASES])(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

    workflow.rule(name=f"kart_theme_{t.name}")(
        workflow.input(f"data/output/{t.name}.bundle")(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

workflow.rule(name="kart_theme_all")(
    workflow.input([f"data/output/{t.name}.bundle" for t in THEMES])(
        workflow.run(lambda *args, **kwargs: None)
    )
)

for repo in REPOS:
    safe_repo_name = repo.replace("-", "_")
    workflow.rule(name=f"kart_import_{safe_repo_name}")(
        workflow.input(f"data/output/{repo}/.imported")(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

    workflow.rule(name=f"push_{safe_repo_name}")(
        workflow.input(f"data/output/{repo}/.pushed")(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

workflow.rule(name="push_all")(
    workflow.input([f"data/output/{repo}/.pushed" for repo in REPOS])(
        workflow.run(lambda *args, **kwargs: None)
    )
)


onsuccess:
    _end_root_span(StatusCode.OK)


onerror:
    _end_root_span(StatusCode.ERROR, "Snakemake execution failed")
