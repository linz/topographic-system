from kart_import.config import (
    get_themes,
    get_releases,
    get_kart_repos,
    DATASET_MAP,
    DATASET_TO_THEME_MAP,
    THEME_SUFFIX,
    TRANSFORM_SUFFIX,
    LOOKUP_TO_THEME_MAP,
)

import atexit
import os
import sys
import threading

from kart_import.log import get_tracer
from opentelemetry.trace import StatusCode, set_span_in_context

# Load configuration details from the Python package
THEMES = get_themes()
RELEASES = get_releases()
REPOS = get_kart_repos()
THEME_MAP = {t.name: t for t in THEMES}

# Start root span for this Snakemake run so all distributed jobs and logs link together
tracer = get_tracer("kart_import")
target_args = [arg for arg in sys.argv[1:] if not arg.startswith("-")]
workflow_target = " ".join(target_args) if target_args else "all"

root_span = tracer.start_span(
    f"snakemake: {workflow_target}",
    attributes={
        "workflow.target": workflow_target,
        "workflow.args": " ".join(sys.argv[1:]),
    },
)
span_ctx = root_span.get_span_context()
run_trace_id = format(span_ctx.trace_id, "032x")
run_span_id = format(span_ctx.span_id, "016x")
os.environ["TRACEPARENT"] = f"00-{run_trace_id}-{run_span_id}-01"

# Per-invocation run id (the trace id, whether generated above or inherited). Used to
# scope log files so each run's logs live in their own directory and match the `TraceId`
# embedded in every JSON log record. `ls -t logs/bundle/` finds the latest run.
RUN_ID = run_trace_id


# --- Mid-level grouping spans: theme > dataset > release --------------------
# `transform` jobs run one per (dataset, release) as a separate `uv run` subprocess,
# all parented directly on the root span via the global TRACEPARENT env var above.
# That makes a theme with several datasets and dozens of releases a flat wall of
# sibling spans. These spans group them: one per theme, one per dataset within it.
_span_lock = threading.Lock()
_theme_spans: dict[str, object] = {}
_dataset_spans: dict[str, object] = {}


def _traceparent_for(span) -> str:
    ctx = span.get_span_context()
    return f"00-{format(ctx.trace_id, '032x')}-{format(ctx.span_id, '016x')}-01"


def get_dataset_traceparent(dataset: str) -> str:
    """
    Lazily creates the theme and dataset grouping spans the first time a transform
    job for `dataset` is scheduled, and returns the traceparent header for the dataset
    span so that job's subprocess parents under it instead of directly under the run's
    root span.
    """
    theme = DATASET_TO_THEME_MAP[dataset]
    with _span_lock:
        theme_span = _theme_spans.get(theme.name)
        if theme_span is None:
            theme_span = tracer.start_span(
                f"theme: {theme.name}",
                context=set_span_in_context(root_span),
                attributes={"theme": theme.name},
            )
            _theme_spans[theme.name] = theme_span

        dataset_span = _dataset_spans.get(dataset)
        if dataset_span is None:
            dataset_span = tracer.start_span(
                f"transform: {dataset}",
                context=set_span_in_context(theme_span),
                attributes={"theme": theme.name, "dataset": dataset},
            )
            _dataset_spans[dataset] = dataset_span

        return _traceparent_for(dataset_span)


def _end_root_span(status_code=None, description=""):
    # The tracer provider flushes/shuts down on its own atexit handler (see log.py);
    # this only needs to end the spans so that handler has something to export.
    with _span_lock:
        for span in list(_dataset_spans.values()) + list(_theme_spans.values()):
            if span.is_recording():
                span.end()
    if root_span.is_recording():
        if status_code is not None:
            root_span.set_status(status_code, description)
        root_span.end()


atexit.register(_end_root_span)


# TARGETS
ALL_IMPORTED = [f"data/output/{repo}/.imported" for repo in REPOS]

rule all:
    input:
        ALL_IMPORTED


# 1. CLONE
rule clone:
    output:
        cloned = "data/source/{dataset}/.cloned"
    shell:
        "uv run python -m kart_import.assets.clone {wildcards.dataset}"


# 2. LIFECYCLE
rule lifecycle:
    input:
        cloned = "data/source/{dataset}/.cloned",
        config = lambda wildcards: f"config/themes/{DATASET_TO_THEME_MAP[wildcards.dataset].name}.yml"
    output:
        lifecycle = "data/working/lifecycle/{dataset}_release" + f"{RELEASES[0].id}-{RELEASES[-1].id}.json"
    shell:
        "uv run python -m kart_import.assets.fid_lifecycle {wildcards.dataset}"


# 3a. EXPORT RELEASES (Produces all release files for a dataset at once)
rule export:
    input:
        cloned = "data/source/{dataset}/.cloned"
    output:
        files = [f"data/working/export/release_{r.id}/{{dataset}}.json" for r in RELEASES]
    shell:
        "uv run python -m kart_import.assets.export {wildcards.dataset}"


# 3b. EXPORT LOOKUP (one export of full lookup source per distinct commit across releases; not per release)
rule export_lookup:
    input:
        cloned = "data/source/{lookup}/.cloned"
    output:
        exported = directory("data/working/export/lookup/{lookup}")
    shell:
        "uv run python -m kart_import.assets.export --lookup {wildcards.lookup}"


# 3c. PREPARE LOOKUPS (slim derived lookup table per commit that will be joined into datasets)
rule prepare_lookup:
    input:
        # clone must be present: prepare reads each commit's declared schema from it.
        cloned = "data/source/{lookup}/.cloned",
        exported = "data/working/export/lookup/{lookup}",
        config = lambda wildcards: f"config/themes/{LOOKUP_TO_THEME_MAP[wildcards.lookup].name}.yml"
    output:
        prepared = directory("data/working/lookup/{lookup}")
    shell:
        "uv run python -m kart_import.assets.prepare {wildcards.lookup}"


# 4. TRANSFORM
rule transform:
    input:
        lifecycle = "data/working/lifecycle/{dataset}_release" + f"{RELEASES[0].id}-{RELEASES[-1].id}.json",
        # clone must be present: transform reads the source's declared schema from it.
        cloned = "data/source/{dataset}/.cloned",
        exported = "data/working/export/release_{release}/{dataset}.json",
        config = lambda wildcards: f"config/themes/{DATASET_TO_THEME_MAP[wildcards.dataset].name}.yml",
        fixups = lambda wildcards: (
            ["src/kart_import/fixups.py"] if DATASET_MAP[wildcards.dataset].fixups else []
        ),
        lookups = lambda wildcards: [
            f"data/working/lookup/{join.lookup}"
            for join in DATASET_MAP[wildcards.dataset].joins
        ],
        # clone must be present (not just the prepared parquet).
        lookup_clones = lambda wildcards: [
            f"data/source/{join.lookup}/.cloned"
            for join in DATASET_MAP[wildcards.dataset].joins
        ],
        example_deps = lambda wildcards: [
            f"data/working/transform/release_{wildcards.release}/{ds.name}{TRANSFORM_SUFFIX}"
            for theme_name in DATASET_MAP[wildcards.dataset].depends_on_themes
            for ds in THEME_MAP[theme_name].datasets
        ]
    output:
        transformed = "data/working/transform/release_{release}/{dataset}" + TRANSFORM_SUFFIX
    params:
        # Overrides the process-wide TRACEPARENT (set above) just for this job, so it
        # nests under its theme/dataset grouping span instead of the run's root span.
        traceparent = lambda wildcards: get_dataset_traceparent(wildcards.dataset)
    shell:
        "TRACEPARENT={params.traceparent} uv run python -m kart_import.assets.transform {wildcards.dataset} {wildcards.release}"


# 5. THEME RELEASE (Merges datasets for a single release)
rule theme_release:
    input:
        config = "config/themes/{theme}.yml",
        transformed = lambda wildcards: [
            f"data/working/transform/release_{wildcards.release}/{ds.name}{TRANSFORM_SUFFIX}"
            for ds in THEME_MAP[wildcards.theme].datasets
        ]
    output:
        merged = "data/working/theme/release_{release}/{theme}" + THEME_SUFFIX
    shell:
        "uv run python -m kart_import.assets.theme {wildcards.theme} {wildcards.release}"

rule kart_theme:
    input:
        themes = lambda wildcards: [
            f"data/working/theme/release_{r.id}/{wildcards.theme}{THEME_SUFFIX}"
            for r in RELEASES
        ]
    output:
        imported = "data/output/{theme}.bundle"
    shell:
        "uv run python -m kart_import.assets.kart_import_theme {wildcards.theme}"

rule kart_repo:
    input:
        themes = lambda wildcards: [
            f"data/output/{t.name}.bundle"
            for t in THEMES if t.target_repo == wildcards.repo
        ]
    output:
        imported = "data/output/{repo}/.imported"
    shell:
        "uv run python -m kart_import.assets.kart_import_repo {wildcards.repo}"


# 6. PUSH (push a built target repo to its GitHub remote - a release-named branch by default)
rule push:
    input:
        imported = "data/output/{repo}/.imported"
    output:
        pushed = "data/output/{repo}/.pushed"
    shell:
        "uv run python -m kart_import.assets.kart_push_repo {wildcards.repo}"


# 7. UTILITY BUNDLE RULE
rule bundle:
    output:
        sentinel = "data/source/{dataset}/.bundle_created"
    log:
        # Per-dataset, per-run log so parallel jobs don't interleave, runs don't clobber
        # each other, and failures are easy to isolate:
        #   grep -l '"SeverityText": "ERROR"' logs/bundle/$RUN_ID/*.log
        # The {RUN_ID} directory matches the `TraceId` in every JSON log record.
        f"logs/bundle/{RUN_ID}/{{dataset}}.log"
    shell:
        "uv run python -m kart_import.assets.bundle {wildcards.dataset} > {log} 2>&1"



for name in DATASET_MAP:
    workflow.rule(name=f"clone_{name}")(
        workflow.input(f"data/source/{name}/.cloned")(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

workflow.rule(name="clone_all")(
    workflow.input([f"data/source/{name}/.cloned" for name in DATASET_MAP])(
        workflow.run(lambda *args, **kwargs: None)
    )
)

workflow.rule(name="bundle_all")(
    workflow.input([f"data/source/{name}/.bundle_created" for name in DATASET_MAP])(
        workflow.run(lambda *args, **kwargs: None)
    )
)

for t in THEMES:
    workflow.rule(name=f"theme_{t.name}")(
        workflow.input([f"data/working/theme/release_{r.id}/{t.name}{THEME_SUFFIX}" for r in RELEASES])(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

    workflow.rule(name=f"kart_theme_{t.name}")(
        workflow.input(f"data/output/{t.name}.bundle")(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

workflow.rule(name="kart_theme_all")(
    workflow.input([f"data/output/{t.name}.bundle" for t in THEMES])(
        workflow.run(lambda *args, **kwargs: None)
    )
)

for repo in REPOS:
    safe_repo_name = repo.replace("-", "_")
    workflow.rule(name=f"kart_import_{safe_repo_name}")(
        workflow.input(f"data/output/{repo}/.imported")(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

    workflow.rule(name=f"push_{safe_repo_name}")(
        workflow.input(f"data/output/{repo}/.pushed")(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

workflow.rule(name="push_all")(
    workflow.input([f"data/output/{repo}/.pushed" for repo in REPOS])(
        workflow.run(lambda *args, **kwargs: None)
    )
)


onsuccess:
    _end_root_span(StatusCode.OK)


onerror:
    _end_root_span(StatusCode.ERROR, "Snakemake execution failed")
