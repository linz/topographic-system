from kart_import.config import (
    get_themes,
    get_selected_themes,
    get_releases,
    get_kart_repos,
    DATASET_MAP,
    DATASET_TO_THEME_MAP,
    EXPORT_DIR,
    SOURCE_DIR,
    THEME_SUFFIX,
    TRANSFORM_SUFFIX,
    LOOKUP_TO_THEME_MAP,
    LOOKUP_MAP,
    SOURCE_REPO_MAP,
    get_source_entry,
    get_source_repo_name,
    theme_dependencies,
)

import atexit
import os
import sys

from kart_import.assets.extract.clone import clone_sentinel_name
from kart_import.env import env_export_url, env_schema_check_mode
from kart_import.schema_check import schema_path
from kart_import.log import get_tracer
from opentelemetry.trace import StatusCode

# Load configuration details from the Python package
# Every theme to build, including ones only built because a selected theme depends on them
THEMES = get_themes()
# The themes KART_IMPORT_THEME picked (all when unset); only these are imported into a repo
SELECTED_THEMES = get_selected_themes()
RELEASES = get_releases()
REPOS = get_kart_repos()
THEME_MAP = {t.name: t for t in THEMES}
# Local source clones; datasets sharing a multi-dataset repo (e.g. topographic-source-data) share one clone.
SOURCE_REPOS = list(SOURCE_REPO_MAP)
CLONE_SENTINEL = clone_sentinel_name()
# Stage 2 defaults to fetching `<entry>.releases.json` and missing per-commit parquets on demand
# from `KART_EXPORT_URL` (defaults to the CloudFront HTTPS export URL) instead of cloning/exporting
# from Kart. `extract_*` targets always clone/export locally from Kart; set `KART_EXPORT_URL=local`
# (or `""`) to force local clone/export for Stage 2 targets too.
_target_args = [arg for arg in sys.argv[1:] if not arg.startswith("-")]
_is_extract_target = any(arg == "extract_all" or arg.startswith("extract_") for arg in _target_args)
EXPORT_URL = None if _is_extract_target else env_export_url()


def cloned(name):
    """Daily sentinel for the source clone a dataset/lookup reads from."""
    return f"{SOURCE_DIR}/{get_source_repo_name(get_source_entry(name))}/{CLONE_SENTINEL}"


def exported_sentinel(name):
    """Sentinel marking a dataset's or lookup's export as complete (see export_paths.entry_exported_sentinel).
    An entry's export dir is shared with every other dataset/lookup sourced from the same repo,
    so it can't be the Snakemake-tracked output itself -- this per-entry file is."""
    return f"{EXPORT_DIR}/.sentinel/{name}.exported"


def repo_themes(repo):
    """Every theme targeting `repo`, plus every theme they transitively depend on
    (`depends_on_themes` and theme lookups) -- the full set `extract_<repo>`/`process_<repo>`
    need, since a cross-theme dependency can point at a theme targeting a different repo."""
    themes = {t.name: t for t in SELECTED_THEMES if t.target_repo == repo}
    pending = list(themes.values())
    while pending:
        for dep_name in theme_dependencies(pending.pop()):
            if dep_name not in themes and dep_name in THEME_MAP:
                themes[dep_name] = THEME_MAP[dep_name]
                pending.append(THEME_MAP[dep_name])
    return list(themes.values())


def repo_datasets(repo):
    """Every dataset `extract_<repo>` must export: every dataset of `repo_themes(repo)`."""
    seen = {}
    for theme in repo_themes(repo):
        for ds in theme.datasets:
            seen[ds.name] = ds
    return list(seen.values())


def repo_lookups(repo):
    """Every source-backed lookup `repo_datasets(repo)` joins against (theme lookups have nothing to export)."""
    return list({join.lookup: None for ds in repo_datasets(repo) for join in ds.joins if not is_theme_lookup(join.lookup)})


def theme_schemas(theme):
    """The schema files a theme's check reads, where they exist (`schema/` is generated, so a
    dev checkout may have none; the check itself reports those as missing)."""
    versions = set(theme.schema_version.values()) | {theme.latest_schema_version}
    return [str(p) for p in (schema_path(theme.name, v) for v in sorted(versions)) if p.exists()]


def is_theme_lookup(name):
    """A lookup that reads a theme this run builds, rather than a cloned source repo."""
    return LOOKUP_MAP[name].theme is not None

# Start root span for this Snakemake run so all distributed jobs and logs link together
tracer = get_tracer("kart_import")
target_args = [arg for arg in sys.argv[1:] if not arg.startswith("-")]
workflow_target = " ".join(target_args) if target_args else "all"

root_span = tracer.start_span(
    f"snakemake: {workflow_target}",
    attributes={
        "workflow.target": workflow_target,
        "workflow.args": " ".join(sys.argv[1:]),
    },
)
span_ctx = root_span.get_span_context()
run_trace_id = format(span_ctx.trace_id, "032x")
run_span_id = format(span_ctx.span_id, "016x")
os.environ["TRACEPARENT"] = f"00-{run_trace_id}-{run_span_id}-01"


def _end_root_span(status_code=None, description=""):
    # The tracer provider flushes/shuts down on its own atexit handler (see log.py);
    # this only needs to end the span so that handler has something to export.
    if root_span.is_recording():
        if status_code is not None:
            root_span.set_status(status_code, description)
        root_span.end()


atexit.register(_end_root_span)


# Rules run `python -m ...`, not `uv run python -m ...`: the `uv run snakemake` that starts the
# pipeline has already put its venv on PATH, so a nested `uv run` would only re-resolve (and,
# without UV_NO_SYNC, try to re-sync) the same environment once per job.

# TARGETS
ALL_IMPORTED = [f"data/output/{repo}/.imported" for repo in REPOS]

rule all:
    input:
        ALL_IMPORTED


# 1. CLONE / DAILY FETCH (one clone per source repo, refreshed at most once per day)
rule clone:
    output:
        cloned = f"{SOURCE_DIR}/{{repo}}/{CLONE_SENTINEL}"
    threads: 1
    shell:
        "OTEL_SERVICE_NAME=clone python -m kart_import.assets.extract.clone {wildcards.repo}"


# 2. EXPORT (per-commit parquets, schema sidecars and release map for any dataset or lookup).
# When KART_EXPORT_URL is set, fetch `<entry>.releases.json` from that remote HTTPS/S3 location
# and download only the needed per-commit parquets not already present locally (no clone needed).
if EXPORT_URL:
    rule export:
        output:
            exported = f"{EXPORT_DIR}/.sentinel/{{entry}}.exported"
        params:
            url = EXPORT_URL,
            releases = ",".join(str(r.id) for r in RELEASES)
        threads: 4
        shell:
            "OTEL_SERVICE_NAME=fetch_export python -m kart_import.assets.fetch_export {wildcards.entry}"
else:
    rule export:
        input:
            cloned = lambda wildcards: cloned(wildcards.entry)
        output:
            exported = f"{EXPORT_DIR}/.sentinel/{{entry}}.exported"
        threads: 4
        shell:
            "OTEL_SERVICE_NAME=export python -m kart_import.assets.extract.export {wildcards.entry}"


# 2b. SCHEMA CHECK (one theme's mapping against its JSON schema; see assets.schema_check_theme).
#     Every dataset waits for its theme's check, so only the themes a target builds are checked,
#     and with KART_SCHEMA_CHECK=strict a theme that fails stops before any work is done on it.
rule schema_check:
    input:
        config = "config/themes/{theme}.yml",
        schemas = lambda wildcards: theme_schemas(THEME_MAP[wildcards.theme])
    output:
        checked = "data/working/schema_check/{theme}.checked"
    params:
        # Re-check when the mode changes, e.g. a `warn` run followed by a `strict` one
        mode = env_schema_check_mode()
    shell:
        "OTEL_SERVICE_NAME=schema_check python -m kart_import.assets.schema_check_theme {wildcards.theme}"


# 3a. LIFECYCLE (derive stable UUIDv7 ids and created_at/updated_at from exported parquets -- no clone needed)
rule lifecycle:
    input:
        schema_checked = lambda wildcards: f"data/working/schema_check/{DATASET_TO_THEME_MAP[wildcards.dataset].name}.checked",
        exported = lambda wildcards: exported_sentinel(wildcards.dataset),
        config = lambda wildcards: f"config/themes/{DATASET_TO_THEME_MAP[wildcards.dataset].name}.yml"
    output:
        lifecycle = "data/working/lifecycle/{dataset}_release" + f"{RELEASES[0].id}-{RELEASES[-1].id}.json"
    shell:
        "OTEL_SERVICE_NAME=lifecycle python -m kart_import.assets.fid_lifecycle {wildcards.dataset}"


# 3b. PREPARE LOOKUPS (slim derived lookup table per commit that will be joined into datasets).
#     A theme lookup instead reads every release of a theme this run builds, so it waits for that
#     theme rather than an export.
rule prepare_lookup:
    input:
        # `exported` already carries each commit's schema sidecar (see assets.extract.export) -- no clone needed.
        exported = lambda wildcards: (
            [] if is_theme_lookup(wildcards.lookup) else exported_sentinel(wildcards.lookup)
        ),
        theme = lambda wildcards: (
            [
                f"data/working/theme/release_{r.id}/{LOOKUP_MAP[wildcards.lookup].theme}{THEME_SUFFIX}"
                for r in RELEASES
            ]
            if is_theme_lookup(wildcards.lookup)
            else []
        ),
        config = lambda wildcards: f"config/themes/{LOOKUP_TO_THEME_MAP[wildcards.lookup].name}.yml"
    output:
        prepared = directory("data/working/lookup/{lookup}")
    shell:
        "OTEL_SERVICE_NAME=prepare_lookup python -m kart_import.assets.prepare {wildcards.lookup}"


# 4. TRANSFORM (every release of one dataset, run together in one process with a thread pool)
rule transform:
    input:
        # `exported` already carries each release's schema sidecar and release map (see assets.extract.export) -- no clone needed.
        lifecycle = "data/working/lifecycle/{dataset}_release" + f"{RELEASES[0].id}-{RELEASES[-1].id}.json",
        exported = lambda wildcards: exported_sentinel(wildcards.dataset),
        config = lambda wildcards: f"config/themes/{DATASET_TO_THEME_MAP[wildcards.dataset].name}.yml",
        fixups = lambda wildcards: (
            ["src/kart_import/fixups.py"] if DATASET_MAP[wildcards.dataset].fixups else []
        ),
        # lookup joins resolve their release->commit map from `exported`'s release map -- no clone needed.
        lookups = lambda wildcards: [
            f"data/working/lookup/{join.lookup}"
            for join in DATASET_MAP[wildcards.dataset].joins
        ],
        example_deps = lambda wildcards: [
            f"data/working/transform/release_{r.id}/{ds.name}{TRANSFORM_SUFFIX}"
            for theme_name in DATASET_MAP[wildcards.dataset].depends_on_themes
            for ds in THEME_MAP[theme_name].datasets
            for r in RELEASES
        ]
    output:
        transformed = [f"data/working/transform/release_{r.id}/{{dataset}}" + TRANSFORM_SUFFIX for r in RELEASES]
    # Only nz_contours_topo_150k is memory-heavy enough to need throttling; keep other transforms light so they don't starve concurrency.
    threads: lambda wildcards: 8 if wildcards.dataset == "nz_contours_topo_150k" else 2
    shell:
        "OTEL_SERVICE_NAME=transform python -m kart_import.assets.transform {wildcards.dataset}"


# 5. THEME RELEASE (every release of one theme, run together in one process with a thread pool)
rule theme_release:
    input:
        config = "config/themes/{theme}.yml",
        transformed = lambda wildcards: [
            f"data/working/transform/release_{r.id}/{ds.name}{TRANSFORM_SUFFIX}"
            for r in RELEASES
            for ds in THEME_MAP[wildcards.theme].datasets
        ]
    output:
        merged = [f"data/working/theme/release_{r.id}/{{theme}}" + THEME_SUFFIX for r in RELEASES]
    threads: 4
    shell:
        "OTEL_SERVICE_NAME=theme_release python -m kart_import.assets.theme {wildcards.theme}"

rule kart_theme:
    input:
        themes = lambda wildcards: [
            f"data/working/theme/release_{r.id}/{wildcards.theme}{THEME_SUFFIX}"
            for r in RELEASES
        ]
    output:
        imported = "data/output/{theme}.bundle"
    shell:
        "OTEL_SERVICE_NAME=kart_theme python -m kart_import.assets.kart_import_theme {wildcards.theme}"

rule kart_repo:
    input:
        themes = lambda wildcards: [
            f"data/output/{t.name}.bundle"
            for t in SELECTED_THEMES if t.target_repo == wildcards.repo
        ]
    output:
        imported = "data/output/{repo}/.imported"
    shell:
        "OTEL_SERVICE_NAME=kart_repo python -m kart_import.assets.kart_import_repo {wildcards.repo}"


# 5b. BUNDLE (pack a built target repo into one git bundle file, ready to download and `kart clone`)
rule bundle:
    input:
        imported = "data/output/{repo}/.imported"
    output:
        bundle = "data/bundle/{repo}.bundle"
    shell:
        "OTEL_SERVICE_NAME=bundle python -m kart_import.assets.bundle_repo {wildcards.repo}"


# 6. PUSH (push a built target repo to its GitHub remote - a release-named branch by default)
rule push:
    input:
        imported = "data/output/{repo}/.imported"
    output:
        pushed = "data/output/{repo}/.pushed"
    shell:
        "OTEL_SERVICE_NAME=push python -m kart_import.assets.kart_push_repo {wildcards.repo}"


# 7. STAGE 1 (clone + extract parquets for every dataset/source lookup into data/export/).
workflow.rule(name="extract_all")(
    workflow.input(
        [exported_sentinel(name) for name in DATASET_MAP]
        + [exported_sentinel(lookup) for lookup in LOOKUP_TO_THEME_MAP if not is_theme_lookup(lookup)]
    )(workflow.run(lambda *args, **kwargs: None))
)


for name in DATASET_MAP:
    workflow.rule(name=f"clone_{name}")(
        workflow.input(cloned(name))(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

workflow.rule(name="clone_all")(
    workflow.input([f"{SOURCE_DIR}/{repo}/{CLONE_SENTINEL}" for repo in SOURCE_REPOS])(
        workflow.run(lambda *args, **kwargs: None)
    )
)

workflow.rule(name="lifecycle_all")(
    workflow.input(
        [f"data/working/lifecycle/{name}_release{RELEASES[0].id}-{RELEASES[-1].id}.json" for name in DATASET_MAP]
    )(workflow.run(lambda *args, **kwargs: None))
)

for t in THEMES:
    workflow.rule(name=f"theme_{t.name}")(
        workflow.input([f"data/working/theme/release_{r.id}/{t.name}{THEME_SUFFIX}" for r in RELEASES])(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

    workflow.rule(name=f"schema_check_{t.name}")(
        workflow.input(f"data/working/schema_check/{t.name}.checked")(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

    workflow.rule(name=f"kart_theme_{t.name}")(
        workflow.input(f"data/output/{t.name}.bundle")(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

# Check every theme's mapping against its schema without building anything (e.g. in CI)
workflow.rule(name="schema_check_all")(
    workflow.input([f"data/working/schema_check/{t.name}.checked" for t in THEMES])(
        workflow.run(lambda *args, **kwargs: None)
    )
)

workflow.rule(name="kart_theme_all")(
    workflow.input([f"data/output/{t.name}.bundle" for t in SELECTED_THEMES])(
        workflow.run(lambda *args, **kwargs: None)
    )
)

for repo in REPOS:
    safe_repo_name = repo.replace("-", "_")

    # Stage 1, scoped to this repo: only the datasets/lookups this repo's themes need.
    workflow.rule(name=f"extract_{safe_repo_name}")(
        workflow.input(
            [exported_sentinel(ds.name) for ds in repo_datasets(repo)]
            + [exported_sentinel(lookup) for lookup in repo_lookups(repo)]
        )(workflow.run(lambda *args, **kwargs: None))
    )

    workflow.rule(name=f"kart_import_{safe_repo_name}")(
        workflow.input(f"data/output/{repo}/.imported")(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

    # Stage 2, scoped to this repo: same target as `kart_import_<repo>` (see `process_all` below).
    workflow.rule(name=f"process_{safe_repo_name}")(
        workflow.input(f"data/output/{repo}/.imported")(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

    workflow.rule(name=f"bundle_{safe_repo_name}")(
        workflow.input(f"data/bundle/{repo}.bundle")(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

    workflow.rule(name=f"push_{safe_repo_name}")(
        workflow.input(f"data/output/{repo}/.pushed")(
            workflow.run(lambda *args, **kwargs: None)
        )
    )

workflow.rule(name="bundle_all")(
    workflow.input([f"data/bundle/{repo}.bundle" for repo in REPOS])(
        workflow.run(lambda *args, **kwargs: None)
    )
)

workflow.rule(name="push_all")(
    workflow.input([f"data/output/{repo}/.pushed" for repo in REPOS])(
        workflow.run(lambda *args, **kwargs: None)
    )
)

# STAGE 2 ENTRY POINT: same target as `all`, named for the two-stage split (see `extract_all`
# above). Set `KART_EXPORT_URL` to fetch exports lazily from a remote HTTPS/S3 location.
workflow.rule(name="process_all")(
    workflow.input(ALL_IMPORTED)(
        workflow.run(lambda *args, **kwargs: None)
    )
)


onsuccess:
    _end_root_span(StatusCode.OK)


onerror:
    _end_root_span(StatusCode.ERROR, "Snakemake execution failed")
